{
  "name": "snowy-desktop-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A voice conversational desktop companion",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.2.1",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "esbuild@0.25.12": true
  }
}
